{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|edit|create|write|str_replace|str_replace_editor|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-generated.mjs\"",
            "bash": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-generated.mjs\"",
            "powershell": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-generated.mjs\"",
            "timeout": 5,
            "timeoutSec": 5
          }
        ]
      }
    ]
  }
}
